# ---------------------------------------------------------------------------
# Copy this file to .env.local. Keep all secret values out of Git.
# ---------------------------------------------------------------------------

# Public site URL (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase browser credentials (optional for the public site; required for admin).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only Supabase service role key. Never use a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct contact email delivery through Resend.
# Create an API key in Resend and verify the sending domain before using it.
# Example sender format: VELNARO <website@velnaro.agency>
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=VELNARO <website@velnaro.agency>

# Optional: used by admin retry notifications through the Supabase Edge Function.
NOTIFY_WEBHOOK_SECRET=your-shared-webhook-secret
