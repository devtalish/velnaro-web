# Copy this file to .env.local. Never commit .env.local or share secret values.

# Local site origin (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Search Console verification token: paste only the exact content value from its HTML meta tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX).
# Analytics loads only after a visitor explicitly opts in.
NEXT_PUBLIC_GA_ID=

# Supabase project credentials.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only key. Never add NEXT_PUBLIC_ to this variable.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: only needed if you later enable the Supabase notification webhook.
# NOTIFY_WEBHOOK_SECRET=your-shared-webhook-secret
