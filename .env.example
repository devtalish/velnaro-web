# ---------------------------------------------------------------------------
# Copy this file to `.env`. `.env*` is gitignored.
#
# Public site URL and Supabase browser credentials are optional for a frontend-only preview.
# You just get a "not connected" panel at /admin and the contact form asks
# visitors to email you directly.
#
# The service-role key is SERVER-ONLY and must never use a NEXT_PUBLIC_ prefix.
# It is used only by the validated contact API route. SMTP secrets stay in Supabase.
# See docs/admin.md before configuring production.
# ---------------------------------------------------------------------------

# Your live domain, no trailing slash. Drives the sitemap, robots.txt, canonical
# URL and every Open Graph image URL. Leave it unset locally.
NEXT_PUBLIC_SITE_URL=https://velnaro.agency

# Supabase → Project Settings → API.
# The anon key is a public identifier, not a secret. Row-level security is what
# decides who can read what. It is safe in a browser bundle, which is why it
# carries the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional. Google Search Console verification token, the `content` value of the
# google-site-verification meta tag. Leave it unset and the tag is not rendered.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Server-only. Required for the secure contact endpoint; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
