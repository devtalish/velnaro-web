# Copy this file to .env.local. Never commit .env.local or share secret values.

# Local site origin (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project credentials.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only key. Never add NEXT_PUBLIC_ to this variable.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: only needed if you later enable the Supabase notification webhook.
# NOTIFY_WEBHOOK_SECRET=your-shared-webhook-secret
